# RelayForge environment configuration.
#   1. Copy this file to .env            (PowerShell: Copy-Item .env.example .env)
#   2. Replace every "change-me" value.  .env is git-ignored - never commit it.
# docker compose reads .env automatically, and so does the app when started from this folder.
# Use plain KEY=value lines: no quotes, no "export", no spaces around "=".

# ---------------------------------------------------------------------------
# Host ports. Change one if it is already in use on your machine.
# A locally started app (mvnw spring-boot:run) also uses these to reach the containers.
# ---------------------------------------------------------------------------
APP_PORT=8080
# actuator (health, Prometheus metrics); published on 127.0.0.1 only
MANAGEMENT_PORT=9091
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=relayforge_db
POSTGRES_USER=relayforge_user
POSTGRES_PASSWORD=change-me-postgres-password

# ---------------------------------------------------------------------------
# RabbitMQ (also the login for the management UI)
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=relayforge_user
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

# ---------------------------------------------------------------------------
# API security (required - the app refuses to start without them)
# API_KEY:    sent by clients in the X-API-KEY header
# JWT_SECRET: HMAC signing key, at least 32 characters. Generate one, e.g. in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ---------------------------------------------------------------------------
API_KEY=change-me-api-key
JWT_SECRET=change-me-jwt-secret-use-at-least-32-random-characters
JWT_EXPIRATION_MS=3600000

# First ADMIN user, created at startup only while no ADMIN exists (12-72 characters).
# The public /auth/register endpoint cannot create ADMIN accounts. Leave empty if an ADMIN already exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---------------------------------------------------------------------------
# Delivery providers
# MOCK_PROVIDER=true logs email/SMS instead of sending them; those notifications end in
# status SIMULATED (never SENT). Set it to false and fill in the credentials below for real delivery.
# ---------------------------------------------------------------------------
MOCK_PROVIDER=true

# SMTP (defaults target Mailtrap's sending service)
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hello@demomailtrap.co

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Time zone of the app container; campaign scheduledTime values are interpreted in it.
APP_TIMEZONE=UTC
# Fraction (0.0-1.0) of deliveries that fail on purpose, to exercise the retry queues.
SIMULATE_FAILURE_RATE=0.0
# Artificial delay of the simulated push channel, in milliseconds.
PUSH_DELAY_MS=1000
# Artificial latency of the mock email/SMS providers in milliseconds (emulates a real provider in load tests).
MOCK_PROVIDER_DELAY_MS=0
# Notification worker threads (RabbitMQ consumers) per app instance.
WORKER_CONCURRENCY=4
WORKER_MAX_CONCURRENCY=8
# PostgreSQL connection pool size.
DB_POOL_SIZE=20
# Request bodies larger than this are rejected with 413 (e.g. 512KB, 2MB).
MAX_REQUEST_BODY_SIZE=1MB

# ---------------------------------------------------------------------------
# Upgrading an installation created before the rename to RelayForge (Compose project "notifyr").
# Uncomment both lines to keep using its database and broker volumes, and keep the POSTGRES_* and
# RABBITMQ_* values from your old .env (the database was initialised with them).
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=notifyr
# RABBITMQ_HOSTNAME=notifyr-rabbitmq
